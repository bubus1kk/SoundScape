{
  "info": {
    "name": "SoundScape — Practice 11 — Negative API tests — LOCAL ONLY",
    "description": "24 negative scenarios against an isolated local Supabase. No production calls, no live music providers, no user passwords. Separate from Practice 10 manual collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:54321"
    },
    {
      "key": "publishableKey",
      "value": "",
      "type": "secret"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = String(pm.variables.get(\"baseUrl\") || \"\").replace(/\\/$/, \"\");",
          "if (baseUrl !== \"http://127.0.0.1:54321\" && baseUrl !== \"http://localhost:54321\") {",
          "  console.error(\"BLOCKED: Practice 11 negative collection is LOCAL ONLY\");",
          "  pm.execution.skipRequest();",
          "}",
          "if (!pm.variables.get(\"publishableKey\")) {",
          "  console.error(\"BLOCKED: provide a local Supabase publishable/anon key\");",
          "  pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — get_visible_places — Invalid latitude in viewport",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{publishableKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/rest/v1/rpc/get_visible_places",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rest",
            "v1",
            "rpc",
            "get_visible_places"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"minLat\": 91,\n  \"maxLat\": 92,\n  \"minLon\": 10,\n  \"maxLon\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Local-only negative scenario. Expected HTTP status: 400, 422. This request must not mutate project data."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status in [400, 422]\", function () {",
              "  pm.expect([400, 422]).to.include(pm.response.code);",
              "});",
              "pm.test(\"Response contains error code and message\", function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.code).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(data.message).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
